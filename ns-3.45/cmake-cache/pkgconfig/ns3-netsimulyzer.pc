exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-netsimulyzer
Description: 
URL: 
Version: 3.45
Requires:  ns3-buildings ns3-core ns3-network ns3-mobility ns3-point-to-point ns3-applications
Requires.private: 
Cflags: -I"${includedir}"  -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr -I/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk/usr/include/libxml2 -I/opt/homebrew/include -I/opt/homebrew/Cellar/gsl/2.8/include
Libs: -L"${libdir}" -lns3.45-netsimulyzer-optimized  -lns3.45-buildings-optimized -lns3.45-core-optimized -lns3.45-network-optimized -lns3.45-mobility-optimized -lns3.45-point-to-point-optimized -lns3.45-applications-optimized
Libs.private: -L"${libdir}" 
